# Copy to .env and edit. Never commit .env.

# Inference backend: mock (default, no weights needed) | llama_cpp | cloud
ROBOUI_BACKEND=mock

# Local GGUF model (quantized Gemma 4 E2B/E4B) + multimodal projector
ROBOUI_MODEL_PATH=models/gemma-4-e2b-it-Q4_K_M.gguf
ROBOUI_MMPROJ_PATH=models/mmproj-gemma-4-e2b-it-F16.gguf

# Context window bounds (tokens). Actual value is throttled to available memory.
ROBOUI_MAX_CTX=8192
ROBOUI_MIN_CTX=1024

# GPU layers to offload (-1 = auto from free VRAM, 0 = CPU only)
ROBOUI_N_GPU_LAYERS=-1

# Optional cloud fallback (only used when ROBOUI_BACKEND=cloud)
ROBOUI_CLOUD_API_KEY=
ROBOUI_CLOUD_MODEL=
ROBOUI_CLOUD_BASE_URL=

LOG_LEVEL=INFO
